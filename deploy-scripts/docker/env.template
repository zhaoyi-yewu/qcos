# Copy env.template to .env and configure .env before running containers.

# QCOS runtime
DEBUG=False
LOCAL_CICD=False
# Used by the webui, base and sandbox targets. The prod/dev targets set it explicitly.
DEV=False

# QCOS API server
API_SERVER_LISTEN_IP=
API_SERVER_LISTEN_PORT=18400
PREFECT_API_URL=http://127.0.0.1:4200/api
QCOS_VERSION=${QCOS_VERSION:-1.0.0}
DEFAULT_ADMIN_PASSWORD=P*ssword1

# Redis
REDIS_SERVER_LISTEN_IP=127.0.0.1
REDIS_SERVER_IP=127.0.0.1
REDIS_SERVER_PORT=6379
REDIS_PASSWORD=Rdk*23r3

# QCOS client
QCOS_SERVER_IP=127.0.0.1
QCOS_SERVER_PORT=18400

# Database: sqlite or postgres
DB_BACKEND=postgres
POSTGRES_ADMIN_PASSWORD=P*ssword1
QCOS_DATABASE_PASSWORD=P*ssword1
QCOS_DATABASE_CONNECTION_URL=postgresql+psycopg://qcos:${QCOS_DATABASE_PASSWORD}@127.0.0.1:5432/qcos

# Authentication: no, jwt or virtual_instance
QCOS_AUTH_MODE=no
QCOS_VIRTUAL_INSTANCE_ID=1234

# WebUI
QCOS_WEBUI_LISTEN_IP=0.0.0.0
QCOS_WEBUI_LISTEN_PORT=18401

# Prefect
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_PORT=4200
PREFECT_LOCAL_STORAGE_PATH=/var/qcos/storage
PREFECT_DATABASE_PASSWORD=P*ssword1
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:${PREFECT_DATABASE_PASSWORD}@127.0.0.1:5432/prefect

# Metrics and logs
METRICS_SERVER_ACCESS_IP=127.0.0.1
METRICS_SERVER_LISTEN_IP=
METRICS_SERVER_LISTEN_PORT=19400
PROMETHEUS_LISTEN_PORT=9090
GRAFANA_LISTEN_PORT=3000
GF_SERVER_ROOT_URL=http://${METRICS_SERVER_ACCESS_IP}:${GRAFANA_LISTEN_PORT}
GRAFANA_ADMIN_PASSWORD=P*ssword1
ALERTMANAGER_LISTEN_PORT=9093
NODE_EXPORTER_LISTEN_PORT=9100
PROCESS_EXPORTER_LISTEN_PORT=9256
VICTORIALOGS_LISTEN_PORT=9428
VICTORIALOGS_RETENTION=30d

# Image registries
QCOS_REGISTRY=
REGISTRY=

# QCOS, Prefect, Redis and PostgreSQL images
QCOS_CONTAINER_NAME=qcos
QCOS_IMAGE_NAME=qcos
QCOS_WEBUI_IMAGE_NAME=qcos-webui
QCOS_IMAGE_VERSION=${QCOS_IMAGE_VERSION:-1.0.0}
PREFECT_IMAGE_NAME=prefecthq/prefect
PREFECT_IMAGE_VERSION=3.8.3-python3.13
REDIS_IMAGE_NAME=redis
REDIS_IMAGE_VERSION=7.2.7
POSTGRES_IMAGE_NAME=pgvector/pgvector
POSTGRES_IMAGE_VERSION=pg18-trixie

# Metrics images
PROMETHEUS_IMAGE_NAME=prom/prometheus
PROMETHEUS_IMAGE_VERSION=v2.51.0
GRAFANA_IMAGE_NAME=grafana/grafana
GRAFANA_IMAGE_VERSION=10.4.0
ALERTMANAGER_IMAGE_NAME=quay.io/prometheus/alertmanager
ALERTMANAGER_IMAGE_VERSION=v0.27.0
NODE_EXPORTER_IMAGE_NAME=prom/node-exporter
NODE_EXPORTER_IMAGE_VERSION=v1.12.1
PROCESS_EXPORTER_IMAGE_NAME=ncabatoff/process-exporter
PROCESS_EXPORTER_IMAGE_VERSION=v0.8.7
VICTORIALOGS_IMAGE_NAME=victoriametrics/victoria-logs
VICTORIALOGS_IMAGE_VERSION=v1.53.0
FLUENTBIT_IMAGE_NAME=fluent/fluent-bit
FLUENTBIT_IMAGE_VERSION=5.1

# AI embedding image
TEI_IMAGE_NAME=ghcr.io/huggingface/text-embeddings-inference
TEI_IMAGE_VERSION=cpu-1.9
TEI_MODEL_ID=/models/bge-m3
TEI_LISTEN_PORT=18500
TEI_OMP_NUM_THREADS=8
