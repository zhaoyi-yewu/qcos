// ==========================================================================
// QCOS CI/CD Jenkins Pipeline
// Ported from: .github/workflows/qcos-cicd.yml
// Excluded: push-docker-images stage
//
// Stage mapping (GitHub Actions -> Jenkins):
//   build-qcos-base-image  -> Build QCOS Base Image
//   build-sandbox-image    -> Build Sandbox Image
//   build-qcos-image       -> Build QCOS Image
//   build-qcos-cli-image   -> Build QCOS-CLI Image
//   run-ut-qcos            -> Run UT - QCOS
//   run-ut-qcos-cli        -> Run UT - QCOS-CLI
//   run-st-qcos            -> Run System Tests - QCOS
//   push-docker-images     -> [EXCLUDED]
//   send-cicd-report       -> post { email notification }
//
// Note: In GitHub Actions, build-qcos-image and build-qcos-cli-image run in
// parallel on separate runners. In Jenkins (shared Docker daemon), they must
// be sequential due to sandbox container name conflict (qcos-sandbox).
// Similarly, UT stages are sequential in Jenkins.
// ==========================================================================

pipeline {
    agent any

    triggers {
        cron('H 22 * * *')
        gitee(
            triggerOnPush: true,
            triggerOnCommitComment: false,
            triggerOnOpenPullRequest: true,
            triggerOnPipelineEvent: false,
            triggerOnAcceptedPullRequest: false,
            triggerOnClosedPullRequest: false,
            triggerOnApprovedPullRequest: false,
            triggerOnNoteRequest: true,
            noteRegex: "Retry build",
            skipWorkInProgressPullRequest: true,
            ciSkip: true,
            skipLastCommitHasBeenBuild: true,
            cancelPendingBuildsOnUpdate: true,
            secretToken: "WuYueOs2026SecureToken"
        )
    }

    parameters {
        string(name: 'GIT_REPO_URL',
               defaultValue: 'ssh://git@gitlab.cmss.com:2223/OCRI/WuYueOs.git',
               description: 'Git repository URL. eg. Gitee (git@gitee.com:WUYUEQbit/qcos.git) or GitLab (ssh://git@gitlab.cmss.com:2223/OCRI/WuYueOs.git)')
        string(name: 'GIT_BRANCH',
               defaultValue: '*/feature_QIS-143_test',
               description: 'Git branch to build. e.g. Gitee (*/develop) or GitLab (*/dev_gitee)')
        string(name: 'GIT_CREDENTIALS_ID',
               defaultValue: 'gitlab-ssh-key',
               description: 'Jenkins stored SSH credential ID for the Git repository. e.g. Gitee (gitee-ssh-key) or GitLab (gitlab-ssh-key)')
        string(name: 'CICD_REPORT_EMAIL',
               defaultValue: 'zhaoyi@cmss.chinamobile.com',
               description: 'Email address(es) for CI/CD report notification. Supports single (user@example.com) or multiple comma-separated (a@example.com,b@example.com). Leave empty to skip email notification.')
        string(name: 'YUM_MIRROR',
               defaultValue: 'http://mirrors.bclinux.org/openeuler',
               description: 'YUM mirror URL. Leave empty to use default. e.g. GitLab (http://mirrors.bclinux.org/openeuler)')
        string(name: 'PIP_MIRROR',
               defaultValue: 'http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/pip/2.7/simple',
               description: 'PIP mirror URL. Leave empty to use default. e.g. GitLab (http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/pip/2.7/simple)')
        string(name: 'NPM_MIRROR',
               defaultValue: 'http://mirrors.bclinux.org:28081/repository/qcos/',
               description: 'NPM mirror URL. Leave empty to use default. e.g. GitLab (http://mirrors.bclinux.org:28081/repository/qcos/)')
        string(name: 'PYTHON_SRC_MIRROR',
               defaultValue: 'http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/extra_pkgs/pkgs/python/python-src/3.11.6/Python-3.11.6.tgz',
               description: 'PYTHON source mirror URL. Leave empty to use default. e.g. GitLab (http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/extra_pkgs/pkgs/python/python-src/3.11.6/Python-3.11.6.tgz)')
        string(name: 'PYPY3_BIN_MIRROR',
               defaultValue: 'http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/extra_pkgs/pkgs/python/pypy/pypy3.11-v7.3.20-linux64.tar.bz2',
               description: 'PYPY3 bin mirror URL. Leave empty to use default. e.g. GitLab (http://mirrors.bclinux.org/bigcloud/bc-uns/bc-uns/extra_pkgs/pkgs/python/pypy/pypy3.11-v7.3.20-linux64.tar.bz2)')
    }

    environment {
        GIT_REPO_URL = "${params.GIT_REPO_URL}"
        GIT_BRANCH = "${params.GIT_BRANCH}"
        GIT_CREDENTIALS_ID = "${params.GIT_CREDENTIALS_ID}"
        CICD_REPORT_EMAIL = "${params.CICD_REPORT_EMAIL}"
        YUM_MIRROR = "${params.YUM_MIRROR}"
        PIP_MIRROR = "${params.PIP_MIRROR}"
        NPM_MIRROR = "${params.NPM_MIRROR}"
        PYTHON_SRC_MIRROR = "${params.PYTHON_SRC_MIRROR}"
        PYPY3_BIN_MIRROR = "${params.PYPY3_BIN_MIRROR}"
    }

    options {
        timestamps()
        timeout(time: 5, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        giteeConnection('my-gitee')
        // Prevent concurrent builds (shared Docker daemon, container name conflicts)
        disableConcurrentBuilds()
    }

    stages {
        // =============================================================
        // Initialize: Checkout code and prepare environment
        // =============================================================
        stage('Initialize') {
            steps {
                script {
                    sh "docker image prune -f || true"
                    sh 'docker rm -f $(docker ps -a --format "{{.Names}}" | egrep "^[a-z]+_[a-z]+$") || true'
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "${params.GIT_BRANCH}"]],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [[$class: 'CleanBeforeCheckout']],
                        submoduleCfg: [],
                        userRemoteConfigs: [[credentialsId: "${params.GIT_CREDENTIALS_ID}", url: "${params.GIT_REPO_URL}"]]
                    ])
                    echo ">>> Build #${env.BUILD_NUMBER} on branch ${env.GIT_BRANCH}"
                    echo ">>> Repo: ${params.GIT_REPO_URL} | Branch: ${params.GIT_BRANCH} | Creds: ${params.GIT_CREDENTIALS_ID}"
                    echo ">>> YUM_MIRROR: ${env.YUM_MIRROR ?: '(default)'}"
                }
            }
        }

        // =============================================================
        // Build Stage 1: Build qcos-base Docker image
        // Maps: GitHub Actions -> build-qcos-base-image
        // =============================================================
        stage('Build QCOS Base Image') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                source ./version
                cp ./env.template ./.env
                if [ -n "${env.YUM_MIRROR}" ]; then
                    sed -i "s@^YUM_MIRROR=.*@YUM_MIRROR=${env.YUM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PIP_MIRROR}" ]; then
                    sed -i "s@^PIP_MIRROR=.*@PIP_MIRROR=${env.PIP_MIRROR}@" ./.env
                fi
                if [ -n "${env.NPM_MIRROR}" ]; then
                    sed -i "s@^NPM_MIRROR=.*@NPM_MIRROR=${env.NPM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYTHON_SRC_MIRROR}" ]; then
                    sed -i "s@^PYTHON_SRC_MIRROR=.*@PYTHON_SRC_MIRROR=${env.PYTHON_SRC_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYPY3_BIN_MIRROR}" ]; then
                    sed -i "s@^PYPY3_BIN_MIRROR=.*@PYPY3_BIN_MIRROR=${env.PYPY3_BIN_MIRROR}@" ./.env
                fi
                df -h
                ./build-images.sh -b -t dev
                """
            }
        }

        // =============================================================
        // Build Stage 2: Build qcos-sandbox Docker image
        // Maps: GitHub Actions -> build-sandbox-image (needs: build-qcos-base-image)
        // =============================================================
        stage('Build Sandbox Image') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                source ./version
                cp ./env.template ./.env
                if [ -n "${env.YUM_MIRROR}" ]; then
                    sed -i "s@^YUM_MIRROR=.*@YUM_MIRROR=${env.YUM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PIP_MIRROR}" ]; then
                    sed -i "s@^PIP_MIRROR=.*@PIP_MIRROR=${env.PIP_MIRROR}@" ./.env
                fi
                if [ -n "${env.NPM_MIRROR}" ]; then
                    sed -i "s@^NPM_MIRROR=.*@NPM_MIRROR=${env.NPM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYTHON_SRC_MIRROR}" ]; then
                    sed -i "s@^PYTHON_SRC_MIRROR=.*@PYTHON_SRC_MIRROR=${env.PYTHON_SRC_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYPY3_BIN_MIRROR}" ]; then
                    sed -i "s@^PYPY3_BIN_MIRROR=.*@PYPY3_BIN_MIRROR=${env.PYPY3_BIN_MIRROR}@" ./.env
                fi
                df -h
                ./build-images.sh -s -t dev
                """
            }
        }

        // =============================================================
        // Build Stage 3: Build qcos Docker image
        // Maps: GitHub Actions -> build-qcos-image (needs: build-sandbox-image)
        // =============================================================
        stage('Build QCOS Image') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/bin/docker-compose 2>/dev/null || true
                source ./version
                cp ./env.template ./.env
                if [ -n "${env.YUM_MIRROR}" ]; then
                    sed -i "s@^YUM_MIRROR=.*@YUM_MIRROR=${env.YUM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PIP_MIRROR}" ]; then
                    sed -i "s@^PIP_MIRROR=.*@PIP_MIRROR=${env.PIP_MIRROR}@" ./.env
                fi
                if [ -n "${env.NPM_MIRROR}" ]; then
                    sed -i "s@^NPM_MIRROR=.*@NPM_MIRROR=${env.NPM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYTHON_SRC_MIRROR}" ]; then
                    sed -i "s@^PYTHON_SRC_MIRROR=.*@PYTHON_SRC_MIRROR=${env.PYTHON_SRC_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYPY3_BIN_MIRROR}" ]; then
                    sed -i "s@^PYPY3_BIN_MIRROR=.*@PYPY3_BIN_MIRROR=${env.PYPY3_BIN_MIRROR}@" ./.env
                fi
                df -h
                ./run-sandbox.sh
                docker exec qcos-sandbox sh -c "source /root/.bashrc; cd /root/qcos-project/build-scripts; ./build-images.sh -q -t dev"
                """
            }
            post {
                always {
                    sh "docker stop qcos-sandbox 2>/dev/null || true"
                    sh "docker rm qcos-sandbox 2>/dev/null || true"
                }
            }
        }

        // =============================================================
        // Build Stage 4: Build qcos-cli Docker image
        // Maps: GitHub Actions -> build-qcos-cli-image (needs: build-sandbox-image)
        // =============================================================
        stage('Build QCOS-CLI Image') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/bin/docker-compose 2>/dev/null || true
                source ./version
                cp ./env.template ./.env
                if [ -n "${env.YUM_MIRROR}" ]; then
                    sed -i "s@^YUM_MIRROR=.*@YUM_MIRROR=${env.YUM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PIP_MIRROR}" ]; then
                    sed -i "s@^PIP_MIRROR=.*@PIP_MIRROR=${env.PIP_MIRROR}@" ./.env
                fi
                if [ -n "${env.NPM_MIRROR}" ]; then
                    sed -i "s@^NPM_MIRROR=.*@NPM_MIRROR=${env.NPM_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYTHON_SRC_MIRROR}" ]; then
                    sed -i "s@^PYTHON_SRC_MIRROR=.*@PYTHON_SRC_MIRROR=${env.PYTHON_SRC_MIRROR}@" ./.env
                fi
                if [ -n "${env.PYPY3_BIN_MIRROR}" ]; then
                    sed -i "s@^PYPY3_BIN_MIRROR=.*@PYPY3_BIN_MIRROR=${env.PYPY3_BIN_MIRROR}@" ./.env
                fi
                df -h
                ./run-sandbox.sh
                docker exec qcos-sandbox sh -c "source /root/.bashrc; cd /root/qcos-project/build-scripts; ./build-images.sh -c -t dev"
                """
            }
            post {
                always {
                    sh "docker stop qcos-sandbox 2>/dev/null || true"
                    sh "docker rm qcos-sandbox 2>/dev/null || true"
                }
            }
        }

        // =============================================================
        // Test Stage 1: Run unit tests for qcos
        // Maps: GitHub Actions -> run-ut-qcos (needs: build-qcos-image)
        // =============================================================
        stage('Run UT - QCOS') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/bin/docker-compose 2>/dev/null || true
                cp ./env.template ./.env
                export SANDBOX_IMAGE_VERSION=dev
                ./run-sandbox.sh
                docker exec qcos-sandbox sh -c "source /root/.bashrc; cd /root/qcos-project; ./cicd/run-tests.sh -b; ./cicd/run-tests.sh -c all"
                """
            }
            post {
                always {
                    sh "docker stop qcos-sandbox 2>/dev/null || true"
                    sh "docker rm qcos-sandbox 2>/dev/null || true"
                }
            }
        }

        // =============================================================
        // Test Stage 2: Run unit tests for qcos-cli
        // Maps: GitHub Actions -> run-ut-qcos-cli (needs: build-qcos-cli-image)
        // =============================================================
        stage('Run UT - QCOS-CLI') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/bin/docker-compose 2>/dev/null || true
                cp ./env.template ./.env
                export SANDBOX_IMAGE_VERSION=dev
                ./run-sandbox.sh
                docker exec qcos-sandbox sh -c "source /root/.bashrc; cd /root/qcos-project; ./cicd/run-tests.sh -e all"
                """
            }
            post {
                always {
                    sh "docker stop qcos-sandbox 2>/dev/null || true"
                    sh "docker rm qcos-sandbox 2>/dev/null || true"
                }
            }
        }

        // =============================================================
        // Test Stage 3: Run system tests for qcos
        // Maps: GitHub Actions -> run-st-qcos (needs: build-qcos-image + build-qcos-cli-image)
        // =============================================================
        stage('Run System Tests - QCOS') {
            steps {
                sh """#!/bin/bash
                set -eo pipefail
                cd build-scripts
                ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/bin/docker-compose 2>/dev/null || true

                TOP_DIR=\$(cd .. && pwd)

                    # Configure environment
                    cp ./env.template ./.env
                    if [ -n "${env.YUM_MIRROR}" ]; then
                        sed -i "s@^YUM_MIRROR=.*@YUM_MIRROR=${env.YUM_MIRROR}@" ./.env
                    fi
                    if [ -n "${env.PIP_MIRROR}" ]; then
                        sed -i "s@^PIP_MIRROR=.*@PIP_MIRROR=${env.PIP_MIRROR}@" ./.env
                    fi
                    if [ -n "${env.NPM_MIRROR}" ]; then
                        sed -i "s@^NPM_MIRROR=.*@NPM_MIRROR=${env.NPM_MIRROR}@" ./.env
                    fi
                    if [ -n "${env.PYTHON_SRC_MIRROR}" ]; then
                        sed -i "s@^PYTHON_SRC_MIRROR=.*@PYTHON_SRC_MIRROR=${env.PYTHON_SRC_MIRROR}@" ./.env
                    fi
                    if [ -n "${env.PYPY3_BIN_MIRROR}" ]; then
                        sed -i "s@^PYPY3_BIN_MIRROR=.*@PYPY3_BIN_MIRROR=${env.PYPY3_BIN_MIRROR}@" ./.env
                    fi
                    sed -i 's@^QCOS_VERSION=.*@QCOS_VERSION=dev@' ./version
                    sed -i 's@^LOCAL_CICD=.*@LOCAL_CICD=True@' ./.env

                    # Prepare config files for system tests
                    # NOTE: In Docker-in-Docker Jenkins setup, /etc/qcos/ refers to the
                    # host path. If Jenkins runs inside a container, you may need to
                    # adjust these paths or use HOST_MOUNT_PREFIX env variable.
                    mkdir -p /etc/qcos/
                    cp -rf \${TOP_DIR}/etc/qcos/st-conf.d /etc/qcos/
                    cp -rf \${TOP_DIR}/etc/qcos/qcos-st.toml /etc/qcos/

                    # Start QCOS system via docker-compose
                    ./run-docker.sh

                    # Wait for qcos-api to become ready
                    QCOS_SERVER_IP=127.0.0.1
                    QCOS_SERVER_PORT=18400
                    MAX_ATTEMPTS=30
                    SLEEP_INTERVAL=10
                    count=0
                    echo "qcos-api: http://\${QCOS_SERVER_IP}:\${QCOS_SERVER_PORT}"
                    until curl -o /dev/null -s http://\${QCOS_SERVER_IP}:\${QCOS_SERVER_PORT} || [ \$count -ge \${MAX_ATTEMPTS} ]; do
                        echo "waiting for qcos-api ... (attempt \$((count+1))/\${MAX_ATTEMPTS})"
                        docker logs qcos
                        sleep \${SLEEP_INTERVAL}
                        count=\$((count+1))
                    done
                    if [ \$count -lt \${MAX_ATTEMPTS} ]; then
                        echo "qcos-api is ready"
                    else
                        total_seconds=\$((MAX_ATTEMPTS * SLEEP_INTERVAL))
                        echo "ERROR: qcos-api did not become ready after \${MAX_ATTEMPTS} attempts (total \${MAX_ATTEMPTS}*\${SLEEP_INTERVAL}=\${total_seconds} seconds)"
                        docker logs qcos
                        echo "Print /var/log/qcos/qcos-api.log ..."
                        cat /var/log/qcos/qcos-api.log || true
                        echo "Print /var/log/qcos/postgresql.log ..."
                        cat /var/log/qcos/postgresql.log || true
                        exit 1
                    fi

                    # Run system tests in qcos container
                    sleep 10
                    echo "Running system tests in container: qcos"
                    cd \${TOP_DIR}
                    tar czf /tmp/cicd.tar.gz ./cicd ./src ./etc ./samples
                    docker cp /tmp/cicd.tar.gz qcos:/tmp/
                    docker exec qcos sh -c "mkdir -p /root/qcos-project/; cd /root/qcos-project/; tar xzf /tmp/cicd.tar.gz"
                    TEST_EXIT_CODE=0
                    docker exec qcos sh -c "source /root/.bashrc; echo 'Transpiler list:'; qcos-cli list-transpilers; echo 'Driver list:'; qcos-cli list-drivers; echo 'Device list:'; qcos-cli list-devices; echo 'Job list:'; qcos-cli list-jobs; cd /root/qcos-project; ./cicd/run-tests.sh -s all" || TEST_EXIT_CODE=\$?

                    # Print log files for debug purpose
                    echo -e "\\n----------------------------------\\nPrint log files for debug purpose:"
                    ls -al /var/log/qcos || true
                    awk 'FNR==1{print "\\n\\n--- Log File: " FILENAME " ---"} {print} END{print ""}' /var/log/qcos/qcos-api.log /var/log/qcos/postgresql.log /var/log/qcos/device*.log || true

                    exit \${TEST_EXIT_CODE}
                    """
            }
            post {
                always {
                    sh "docker stop qcos prefect-server redis 2>/dev/null || true"
                    sh "docker rm qcos prefect-server redis 2>/dev/null || true"
                }
            }
        }
    }

    post {
        always {
            script {
                // Cleanup dangling images
                sh "docker image prune -f || true"
                sh 'docker rm -f $(docker ps -a --format "{{.Names}}" | egrep "^[a-z]+_[a-z]+$") || true'
            }
        }
        success {
            script {
                if (env.CICD_REPORT_EMAIL) {
                    echo "Attempting to send SUCCESS email to: ${env.CICD_REPORT_EMAIL}"
                    try {
                        emailext(
                            subject: "[QCOS CI/CD] ✅ SUCCESS — Build #${env.BUILD_NUMBER} on ${env.GIT_BRANCH}",
                            body: """<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"/></head>
<body style="font-family:sans-serif;background:#f6f8fa;padding:24px;">
<div style="max-width:680px;margin:0 auto;background:#fff;border-radius:8px;border:1px solid #d0d7de;overflow:hidden;">
  <div style="padding:24px 28px;border-bottom:1px solid #d0d7de;">
    <h1 style="margin:0 0 4px;font-size:20px;">🚀 QCOS CI/CD Pipeline Report</h1>
    <p style="color:#57606a;font-size:14px;margin:0;">Build #${env.BUILD_NUMBER} · ${env.GIT_BRANCH}</p>
  </div>
  <div style="padding:16px 28px;background:#dafbe1;color:#1a7f37;font-size:18px;font-weight:600;">
    Overall Status: ✅ SUCCESS
  </div>
  <div style="padding:20px 28px;">
    <h2 style="font-size:14px;color:#57606a;text-transform:uppercase;letter-spacing:.05em;margin:0 0 12px;">Pipeline Details</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;font-size:14px;">
      <span style="color:#57606a;">Branch</span><span>${env.GIT_BRANCH}</span>
      <span style="color:#57606a;">Commit</span><span>${env.GIT_COMMIT ?: 'N/A'}</span>
      <span style="color:#57606a;">Build</span><span>#${env.BUILD_NUMBER}</span>
    </div>
    <a href="${env.BUILD_URL}" style="display:inline-block;margin-top:20px;padding:10px 20px;background:#0969da;color:#fff;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;">View Full Run Logs →</a>
  </div>
  <div style="padding:16px 28px;border-top:1px solid #d0d7de;font-size:12px;color:#57606a;text-align:center;">
    This email was sent automatically by Jenkins · QCOS CI/CD Pipeline
  </div>
</div>
</body>
</html>""",
                            to: "${env.CICD_REPORT_EMAIL}",
                            mimeType: 'text/html'
                        )
                        echo "SUCCESS email sent successfully"
                    } catch (Exception e) {
                        echo "SUCCESS email send failed: ${e.message}"
                    }
                }
            }
        }
        failure {
            script {
                if (env.CICD_REPORT_EMAIL) {
                    emailext(
                        subject: "[QCOS CI/CD] ❌ FAILED — Build #${env.BUILD_NUMBER} on ${env.GIT_BRANCH}",
                        body: """<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"/></head>
<body style="font-family:sans-serif;background:#f6f8fa;padding:24px;">
<div style="max-width:680px;margin:0 auto;background:#fff;border-radius:8px;border:1px solid #d0d7de;overflow:hidden;">
  <div style="padding:24px 28px;border-bottom:1px solid #d0d7de;">
    <h1 style="margin:0 0 4px;font-size:20px;">🚀 QCOS CI/CD Pipeline Report</h1>
    <p style="color:#57606a;font-size:14px;margin:0;">Build #${env.BUILD_NUMBER} · ${env.GIT_BRANCH}</p>
  </div>
  <div style="padding:16px 28px;background:#ffebe9;color:#cf222e;font-size:18px;font-weight:600;">
    Overall Status: ❌ FAILED
  </div>
  <div style="padding:20px 28px;">
    <h2 style="font-size:14px;color:#57606a;text-transform:uppercase;letter-spacing:.05em;margin:0 0 12px;">Pipeline Details</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;font-size:14px;">
      <span style="color:#57606a;">Branch</span><span>${env.GIT_BRANCH}</span>
      <span style="color:#57606a;">Commit</span><span>${env.GIT_COMMIT ?: 'N/A'}</span>
      <span style="color:#57606a;">Build</span><span>#${env.BUILD_NUMBER}</span>
    </div>
    <a href="${env.BUILD_URL}" style="display:inline-block;margin-top:20px;padding:10px 20px;background:#0969da;color:#fff;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;">View Full Run Logs →</a>
  </div>
  <div style="padding:16px 28px;border-top:1px solid #d0d7de;font-size:12px;color:#57606a;text-align:center;">
    This email was sent automatically by Jenkins · QCOS CI/CD Pipeline
  </div>
</div>
</body>
</html>""",
                        to: "${env.CICD_REPORT_EMAIL}",
                        mimeType: 'text/html'
                    )
                }
            }
        }
        unstable {
            script {
                if (env.CICD_REPORT_EMAIL) {
                    emailext(
                        subject: "[QCOS CI/CD] ⚠️ UNSTABLE — Build #${env.BUILD_NUMBER} on ${env.GIT_BRANCH}",
