[MAIN]

# 实际使用时可以按需禁用或启用其他pylint自带的检查
# 但如下规则必须显式禁用，因为其与公司python规范冲突：
#     R0205: useless-object-inheritance

disable=all
enable=
    E0001, # 语法错误
    E7201, # lang/c3/c3_1/copyright                   版权注释
    W7201, # lang/c3/c3_1/interpreter_check           文件开头的python解释器
    E7202, # lang/c3/c3_1/utf8_header                 utf8 header
    E7301, # lang/c3/c3_1/tab                         禁止使用tab缩进
    E7302, # lang/c3/c3_1/long_parameter_list_no_first_line 多行参数表禁止在第一行写参数
    E7303, # lang/c3/c3_1/lf                          行结尾检查
    E7304, # lang/c3/c3_6/todo_comment                todo注释格式检查
    E7305, # lang/c3/c3_7/strict_oct【py2 only】      使用py3兼容的八进制格式
    # W7301 is removed （顶层定义空行间隔检查，因框架限制难以实现，可以考虑与其他lint工具一起使用进行检查）
    W7302, # lang/c3/c3_1/white_spaces                括号内侧不应当有空格
    W7303, #                                          数组访问不应当有空格
    W7304, #                                          逗号、分号、冒号前不要加空格
    W7305, # lang/c3/c3_1/trailing_comma              结尾分号相关规范
    E7306, # lang/c3/c3_5/explict_inherit_object      显式指定继承自object
    E7307, # lang/c3/c3_7/except_py3_style【py2 only】使用py3兼容的try-except语法
    W7701, # safety/c3/c3_1/system_cmds               避免使用一些系统命令（建议对特定命令做封装，然后禁用特定函数文件的lint检查）
    E7701, # safety/c3/c3_1/forbid_eval               禁止使用eval
    W0311, # 要求4个缩进
    C0303, # 行尾空格
    C0301, # 行长度
    C0410, # 单行存在多个import
    C0103, # 非法命名
    W0702, # 未指定异常类型
    W1405, # 同文件中字符串引号使用不一致
    W0404, # 重复import
    W0401, # 通配符import
    C0115, # 类文档

max-line-length=80
check-quote-consistency=yes

# pylint for py2 requires this, otherwise it will require at least 3 chars variable names
variable-rgx=^_*[a-z][a-z0-9]*((_[a-z0-9]+)*)?$
argument-rgx=^_*[a-z][a-z0-9]*((_[a-z0-9]+)*)?$

load-plugins=
    cmss_checkers.lang.c2.c2_1.copyright,
    cmss_checkers.lang.c2.c2_1.interpreter_check,
    cmss_checkers.lang.c2.c2_1.utf8_header,
    cmss_checkers.lang.c3.c3_1.tab,
    cmss_checkers.lang.c3.c3_1.long_parameter_list_no_first_line,
    cmss_checkers.lang.c3.c3_1.lf,
    cmss_checkers.lang.c3.c3_1.white_spaces,
    cmss_checkers.lang.c3.c3_1.trailing_comma,
    cmss_checkers.lang.c3.c3_5.explict_inherit_object,
    cmss_checkers.lang.c3.c3_6.todo_comment,
    cmss_checkers.safety.c3.c3_1.system_cmds,
    cmss_checkers.safety.c3.c3_1.forbid_eval,
