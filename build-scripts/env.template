# copy env.template to .env, and configure .env
# QCOS configures
DEBUG=False
LOCAL_CICD=False
# Product mode: DEV=True. Development mode: DEV=True.
DEV=False
# Offline mode. OpenEuler yum mirror, eg. YUM_MIRROR=http://mirrors.cmecloud.cn
YUM_MIRROR=
# Offline mode. Python pip mirror, eg. PIP_MIRROR=http://mirrors.cmecloud.cn/pip/simple
PIP_MIRROR=

# QCOS server configures
API_SERVER_LISTEN_IP=
API_SERVER_LISTEN_PORT=18400
PREFECT_API_URL=http://127.0.0.1:4200/api

# QCOS client configures
QCOS_SERVER_IP=127.0.0.1
QCOS_SERVER_PORT=18400
QCOS_VIRTUAL_INSTANCE_ID=

# Prefect configures
# listen on all IPv4+IPv6 address (Default): PREFECT_SERVER_API_HOST=
# listen on all IPV4 address: PREFECT_SERVER_API_HOST=0.0.0.0
# listen on all IPv6 address: PREFECT_SERVER_API_HOST=::
PREFECT_SERVER_API_HOST=

# container image name and version
QCOS_CONTAINER_NAME=qcos
QCOS_IMAGE_NAME=qcos
QCOS_IMAGE_VERSION=2025-06-01
PREFECT_IMAGE_NAME=prefecthq/prefect
PREFECT_IMAGE_VERSION=3.3.3-python3.13
QCOS_CLI_VERSION=1.0.0
QCOS_CLI_DIST=.oe1
CONTAINER_BASE_IMAGE=openeuler/openeuler:24.03-lts
OUTPUT_IMAGE_DIR=./images
REGISTRY=
