@startuml circuit-aggregation
' 统一全局字体，确保中文正常显示
skinparam defaultFontName "Noto Sans CJK SC"
skinparam dpi 300

' 总体概览：三种聚合模式的简洁对比
skinparam backgroundcolor #FFFFFF
skinparam defaultTextAlignment center

start

:【量子线路聚合】;

partition "聚合模式选择" {
    if (circuit_aggregation?) then (None)
        :无聚合模式;
        :每个源码独立执行;
        :返回multiple results;
    else if (Internal)
        :任务内聚合;
        :多源码分组执行;
        :按qubit分割结果;
    else (External)
        :任务间聚合;
        :Parent+Sub协调;
        :最少执行次数;
    endif
}

:返回job_results_list;

stop

@enduml
